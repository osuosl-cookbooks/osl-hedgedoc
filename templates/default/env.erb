# This file is managed by Chef (osl-hedgedoc). Local changes will be overwritten.

# Compose interpolation / container settings
HEDGEDOC_VERSION=<%= @version %>
APP_PORT=<%= @port %>
RESTART_POLICY=unless-stopped
TZ=<%= @timezone %>

# Database
CMD_DB_URL=<%= @db_url %>

# Reverse proxy / URL generation. TLS is terminated externally by HAProxy, so we
# advertise https URLs without appending the backend port.
CMD_DOMAIN=<%= @domain %>
CMD_PROTOCOL_USESSL=true
CMD_URL_ADDPORT=false

# Application
CMD_SESSION_SECRET=<%= @session_secret %>
CMD_ALLOW_ANONYMOUS=<%= @allow_anonymous %>
CMD_ALLOW_EMAIL_REGISTER=<%= @allow_email_register %>
<% unless @ldap.empty? -%>

# LDAP authentication
<% @ldap.sort.each do |key, value| -%>
CMD_LDAP_<%= key.to_s.upcase %>=<%= value %>
<% end -%>
<% end -%>
<% unless @oauth2.empty? -%>

# OAuth2 / OpenID Connect
<% @oauth2.sort.each do |key, value| -%>
CMD_OAUTH2_<%= key.to_s.upcase %>=<%= value %>
<% end -%>
<% end -%>
<% unless @extra_options.empty? -%>

# Additional settings (extra_options)
<% @extra_options.sort.each do |key, value| -%>
<%= key %>=<%= value %>
<% end -%>
<% end -%>
